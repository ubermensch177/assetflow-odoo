datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Asset {
  id               String            @id @default(uuid())
  name             String
  assetTag         String            @unique
  serialNumber     String            @unique
  category         String
  department       String
  location         String
  purchaseDate     DateTime
  purchaseCost     Float
  warrantyExpiry   DateTime?
  warranty         String?
  vendor           String?
  supplier         String?
  expectedLifetime Int
  condition        String
  assetImage       String?
  remarks          String?
  sharedResource   Boolean           @default(false)
  currentHolderId  String?
  status           String            @default("Available")
  
  allocations      AssetAllocation[]
  history          AssetHistory[]
  documents        AssetDocument[]
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model AssetAllocation {
  id              String    @id @default(uuid())
  assetId         String
  asset           Asset     @relation(fields: [assetId], references: [id])
  assignedTo      String
  assignedDate    DateTime  @default(now())
  returnDate      DateTime?
  expectedReturn  DateTime?
  purpose         String?
  notes           String?
  conditionOnOut  String?
  conditionOnIn   String?
  status          String
}

model AssetHistory {
  id          String   @id @default(uuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  action      String
  performedBy String
  date        DateTime @default(now())
  details     String?
}

model AssetDocument {
  id       String @id @default(uuid())
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id])
  name     String
  fileUrl  String
  type     String
}
